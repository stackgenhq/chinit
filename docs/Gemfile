# Local docs-site preview. The github-pages gem pins the same Jekyll
# and plugin versions GitHub Pages builds with, so local output matches
# the deployed site. This file is excluded from the published site
# (see `exclude:` in _config.yml).
#
#   cd docs
#   bundle install
#   bundle exec jekyll serve --baseurl ""   # http://localhost:4000
#
source "https://rubygems.org"

gem "github-pages", group: :jekyll_plugins
