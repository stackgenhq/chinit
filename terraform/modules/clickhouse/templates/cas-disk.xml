<!-- Shared CAS pool disk (Altinity Antalya `metadata_type = cas`).
     Rendered only when cas_enabled = true (modules/clickhouse/locals.tf).

     Why: the per-replica cold prefixes make every replica store its own
     copy of every merged part. CAS makes the pool itself the source of
     truth: each blob is stored once under its content hash, replicas
     publish refs instead of copying bytes, and GC is a reachability
     sweep over the bucket - no Keeper state, no refcount to corrupt.
     Endpoint is the bucket ROOT (no key prefix here): the pool prefix is
     part of the CAS layout, derived from `cas_prefix` below, and must be
     SHARED across replicas (a per-replica prefix defeats dedup).
     `cas_server_root_id` is the per-server identity inside the pool:
     distinct per replica, stable across restarts of that replica. -->
            <cas>
                <type>object_storage</type>
                <object_storage_type>s3</object_storage_type>
                <metadata_type>cas</metadata_type>
                <cas_server_root_id from_env="CH_CAS_SERVER_ROOT_ID" />
                <endpoint from_env="CH_S3_ENDPOINT" />
                <endpoint_subpath>${cas_prefix}/tiered/</endpoint_subpath>
                <use_environment_credentials>true</use_environment_credentials>
                <skip_bucket_creation>true</skip_bucket_creation>
                <http_keep_alive_timeout>30</http_keep_alive_timeout>
                <http_keep_alive_max_requests>10000</http_keep_alive_max_requests>
                <!-- Source-tuned CAS parameters (ContentAddressedSettings.cpp):
                     - cas_gc_interval_sec=300 (vs 60s default): cuts idle GC S3 GET/PUT
                       chatter 5x while cold parts drop on daily TTL boundaries.
                     - cas_mount_lease_ttl_ms=60000 / cas_mount_renew_period_ms=20000
                       (vs 30s/10s default): halves mount-renewal S3 conditional PUTs and
                       prevents transient gc_fence_out under 30+ TB/day load.
                     - cas_unsafe_remount_no_delay=true: reclaims this server's own UUID
                       mount slot immediately on restart without waiting out the old lease TTL.
                     - cas_blob_hash=xxh3-128 + cas_blob_hash_allow_new=true: SIMD XXH3-128
                       content hashing (CasXxh3Streamer.h) while admitting existing cityhash128 blobs. -->
                <cas_gc_interval_sec>300</cas_gc_interval_sec>
                <cas_mount_lease_ttl_ms>60000</cas_mount_lease_ttl_ms>
                <cas_mount_renew_period_ms>20000</cas_mount_renew_period_ms>
                <cas_unsafe_remount_no_delay>true</cas_unsafe_remount_no_delay>
                <cas_blob_hash>xxh3-128</cas_blob_hash>
                <cas_blob_hash_allow_new>true</cas_blob_hash_allow_new>
            </cas>
            <!-- Cache wrapper over the CAS pool. Policy volumes reference
                 this disk (not the raw `cas` disk); the raw disk is the
                 single source of truth for the pool and must not be
                 referenced by policies directly. -->
            <cas_cache>
                <type>cache</type>
                <disk>cas</disk>
                <path>/var/lib/clickhouse/disks/cas_cache/</path>
                <max_size>${cas_cache_max_size_bytes}</max_size>
                <cache_on_write_operations>true</cache_on_write_operations>
            </cas_cache>
